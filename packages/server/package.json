{
  "name": "@artemis-e2e/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --external better-sqlite3 --clean --dts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@artemis-e2e/shared": "*",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.1.0",
    "better-sqlite3": "^12.6.2",
    "fast-xml-parser": "^5.4.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "tar": "^7.5.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/tar": "^7.0.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
