# Upload token - used by CI to authenticate uploads
UPLOAD_TOKEN=your-secret-upload-token

# GitHub token - used for PR status checks during cleanup
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App URL - used for OAuth callback URL
APP_URL=http://ba-oliva.aet.cit.tum.de

# Session secret - used to sign JWT cookies (generate with: openssl rand -base64 32)
SESSION_SECRET=generate-with-openssl-rand-base64-32

# GitHub OAuth App credentials (optional - enables login)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
